# Copy to .env — defaults provide a 100% offline, air-gapped, single-machine setup.

# --- Storage & Database ------------------------------------------------------
EVIDENCEOS_DATA_DIR=./data            # originals, page crops, reports, sqlite db
DATABASE_URL=sqlite:///./data/evidenceos.db   # or postgresql+psycopg://evidenceos:evidenceos@localhost:5432/evidenceos (pgvector)

# --- Distributed Cache & Object Storage (Redis & MinIO) ----------------------
# Optional: leave empty for in-memory cache and local filesystem store.
REDIS_URL=redis://localhost:6379/0    # for Celery/job broker, query cache, rate limiting
MINIO_ENDPOINT=localhost:9000         # S3-compatible object storage for originals, crops, reports
MINIO_ACCESS_KEY=evidenceos
MINIO_SECRET_KEY=evidenceos-secret
MINIO_BUCKET=evidenceos
MINIO_SECURE=0

# --- Offline / Air-Gapped Local LLM (Ollama: Llama 3 / Qwen 2.5) ------------
# Without an LLM, the system answers purely extractively; numeric answers NEVER depend on LLMs.
# To run local Ollama: run `ollama serve` and `ollama pull llama3:8b` or `ollama pull qwen2.5:7b`
LLM_PROVIDER=ollama                   # "ollama" (local air-gapped default), "openai", "vllm", "groq"
LLM_BASE_URL=http://localhost:11434   # Ollama local endpoint (in docker-compose: http://ollama:11434)
LLM_MODEL=llama3:8b                   # local model (e.g. llama3:8b, qwen2.5:7b)
LLM_API_KEY=                          # not required for Ollama; set only if using OpenAI / Groq

# --- Document AI & Embeddings ------------------------------------------------
EVIDENCEOS_EMBEDDINGS=1               # fastembed bge-small on CPU (set 0 to use BM25 only)
EVIDENCEOS_OCR_DPI=170
EVIDENCEOS_CONFLICT_TOL=0.00002       # relative tolerance for cross-document conflict detection
EVIDENCEOS_WORKER=1                   # set 0 when running a separate worker container

# --- Bhashini Indic AI (MeitY) -----------------------------------------------
# Enables Indic OCR & NMT translation for Hindi, Bengali, Odia, Marathi, etc.
# Works offline with Indic regex and glossary; provide keys for live ULCA cloud inference.
BHASHINI_ENABLED=1
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_PIPELINE_ID=

# --- Government Integrations (API Setu, DigiLocker, data.gov.in) --------------
# Optional: sandbox mode works out of the box without external API keys.
APISETU_CLIENT_ID=
APISETU_API_KEY=
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
DATAGOV_API_KEY=

